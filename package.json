{
  "name": "aegis-grid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "contracts": "openapi-typescript packages/contracts/generated/openapi.json -o packages/contracts/generated/api.d.ts",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm --filter @aegis/executor test",
    "test:e2e": "playwright test",
    "lint": "eslint apps/web/src services/executor/src tests/e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
