# Created with random local-only values by python tools/dev.py start.
# Never use these development tokens for cloud or production.
AEGIS_VIEWER_TOKEN=
AEGIS_SERVICE_TOKEN=
AEGIS_REDIS_PASSWORD=
AEGIS_MONGO_PASSWORD=
AEGIS_SEED=42
# Startup selects a free loopback port and saves it here:
# AEGIS_WEB_PORT=8080
# Future integrations, not read or implemented in Phase 2:
# EVOLUS_API_KEY=
# EVOLUS_BASE_URL=
# EVOLUS_MCP_URL=
# PINECONE_API_KEY=
# MI300X_HOST=
# INFERENCE_BASE_URL=
# INFERENCE_API_KEY=

# Local simulator only. Seed overrides descriptor seed in live mode.
AEGIS_SCENARIO=scenario-000
AEGIS_TIME_SCALE=1

# Independent local simulator safety; observe_only is for explicit comparison tests.
AEGIS_SAFETY_MODE=enforce
AEGIS_EDGE_MEMORY_CAPACITY=256
# Native library path is normally provided by the container.
# AEGIS_TWIN_LIBRARY=/usr/local/lib/libaegis_twin.so
# Optional AEGIS cloud protocol, distinct from MI300X/provider APIs. HTTPS only.
# AEGIS_CLOUD_EVENTS_URL=https://YOUR_AEGIS_HOST/api/v1/edge/events
# AEGIS_CLOUD_EVENTS_TOKEN=

# Local storage identities are generated by startup. Admin secrets stay out of API.
AEGIS_MONGO_WRITER_PASSWORD=
AEGIS_MONGO_READER_PASSWORD=
AEGIS_REDIS_WRITER_PASSWORD=
AEGIS_INGEST_TOKEN=
AEGIS_GRAPH_PASSWORD=
AEGIS_APPROVER_TOKEN=
AEGIS_APPROVER_PASSWORD=
AEGIS_GATEWAY_PASSWORD=
AEGIS_EXECUTOR_TOKEN=
AEGIS_GATEWAY_TOKEN=
AEGIS_CAPABILITY_SIGNING_SEED=
# Derived public key (not secret), set by startup after building the Python image:
# AEGIS_CAPABILITY_PUBLIC_KEY=
# Local WebAuthn RP ID is localhost. Production TLS/identity remains unverified.
# Enabled by the local API Compose service; false for standalone transport-only tests.
# AEGIS_STORAGE_ENABLED=true

# Evolus: verified provider read adapter; configure only in ignored .env.
# EVOLUS_APPLICATION_ID=
# EVOLUS_AUTH_KIND=application
# EVOLUS_MEMORY_ID=
# EVOLUS_DOCUMENT_ID=
# Pinecone vector index (256 dimensions, cosine); explicit scoped ingestion CLIs only.
# PINECONE_INDEX_HOST=

# Phase 6 serving probes: use an authorized HTTPS inference endpoint.
# AEGIS_CONTEXT_TOKENS=8192
# AEGIS_CONCURRENT_SEQUENCES=1

# AMD Token Factory hosted opinion probe (not MI300X acceptance or automatic graph enablement):
# INFERENCE_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Uses INFERENCE_API_KEY above; never commit its value.
# Reviewed default order: DeepSeek-V4-Flash, GLM-5.3-Flash, Qwen3.8-Flash-Next
# python tools/live_knowledge.py ingest performs real scoped external upserts.
# python tools/run_hosted_graph.py runs bounded AMD + Pinecone + native simulator acceptance.
# Hosted graph is opt-in; default local Compose has no provider credentials/egress.
# Public references: python tools/acquire_real_world.py all
# Reads only proof: python tools/check_real_world_graph.py
# Destination is fixed to real-world-v1; no delete or blind overwrite operation.

# Unified hosted application: explicitly add infra/local/compose.hosted.yaml.
# Default compose stays offline. Model cache and immutable retrieval snapshots are read-only.
# AEGIS_MODEL_CACHE=C:/Users/YOU/.cache/huggingface
# AEGIS_INVESTIGATION_MODE=offline
# Separately scoped commissioned replay approval; disabled unless explicitly selected.
# AEGIS_COMMISSIONED_SIMULATOR_ENABLED=false
# python tools/snapshot_cloud_knowledge.py reads existing records; performs no writes.
# Session limits persist until API restart: 6 AMD attempts/32768 reserved tokens,
# 12 dual searches. No automatic session reset on failures, 429, or new incidents.
