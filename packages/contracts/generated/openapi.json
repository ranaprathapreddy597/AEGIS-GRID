{
  "components": {
    "schemas": {
      "AnomalyEvidence": {
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "enum": [
              "CELL-01",
              "CELL-02",
              "CELL-03",
              "CELL-04",
              "CELL-05",
              "CELL-06"
            ],
            "title": "Cell Id",
            "type": "string"
          },
          "estimated_temperature_c": {
            "title": "Estimated Temperature C",
            "type": "number"
          },
          "observed_temperature_c": {
            "title": "Observed Temperature C",
            "type": "number"
          },
          "reason": {
            "enum": [
              "physics_disagreement",
              "thermal_limit",
              "stale_measurement",
              "missing_packets"
            ],
            "title": "Reason",
            "type": "string"
          },
          "residual_c": {
            "title": "Residual C",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "residual_c",
          "estimated_temperature_c",
          "observed_temperature_c",
          "reason"
        ],
        "title": "AnomalyEvidence",
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "mode": {
            "const": "local_simulation",
            "default": "local_simulation",
            "title": "Mode",
            "type": "string"
          },
          "mutations_enabled": {
            "const": false,
            "default": false,
            "title": "Mutations Enabled",
            "type": "boolean"
          },
          "phase": {
            "const": 3,
            "default": 3,
            "title": "Phase",
            "type": "integer"
          }
        },
        "required": [
          "capabilities"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "verified_local",
              "simulated",
              "blocked",
              "not_implemented"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ],
        "title": "Capability",
        "type": "object"
      },
      "CellMeasurement": {
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "enum": [
              "CELL-01",
              "CELL-02",
              "CELL-03",
              "CELL-04",
              "CELL-05",
              "CELL-06"
            ],
            "title": "Cell Id",
            "type": "string"
          },
          "flow_kg_s": {
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Flow Kg S",
            "type": "number"
          },
          "heat_input_w": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Heat Input W",
            "type": "number"
          },
          "load_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Load Fraction",
            "type": "number"
          },
          "noise_bound_c": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Noise Bound C",
            "type": "number"
          },
          "temperature_c": {
            "maximum": 1000.0,
            "minimum": -273.15,
            "title": "Temperature C",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "temperature_c",
          "load_fraction",
          "heat_input_w",
          "noise_bound_c",
          "flow_kg_s"
        ],
        "title": "CellMeasurement",
        "type": "object"
      },
      "EdgeIncident": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Event Id",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/AnomalyEvidence"
            },
            "maxItems": 12,
            "title": "Evidence",
            "type": "array"
          },
          "kind": {
            "enum": [
              "anomaly",
              "local_stop"
            ],
            "title": "Kind",
            "type": "string"
          },
          "policy_revision": {
            "const": "synthetic-shield-v1",
            "default": "synthetic-shield-v1",
            "title": "Policy Revision",
            "type": "string"
          },
          "run_id": {
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Run Id",
            "type": "string"
          },
          "simulation_time_s": {
            "minimum": 0.0,
            "title": "Simulation Time S",
            "type": "number"
          },
          "state_version": {
            "minimum": 1.0,
            "title": "State Version",
            "type": "integer"
          }
        },
        "required": [
          "event_id",
          "run_id",
          "state_version",
          "simulation_time_s",
          "kind",
          "evidence"
        ],
        "title": "EdgeIncident",
        "type": "object"
      },
      "EdgeStatus": {
        "additionalProperties": false,
        "properties": {
          "cloud": {
            "enum": [
              "disabled",
              "offline",
              "online"
            ],
            "title": "Cloud",
            "type": "string"
          },
          "detector": {
            "const": "sensor-only-thermal-observer-v1",
            "default": "sensor-only-thermal-observer-v1",
            "title": "Detector",
            "type": "string"
          },
          "dropped_events": {
            "minimum": 0.0,
            "title": "Dropped Events",
            "type": "integer"
          },
          "execution": {
            "const": "isolated_simulator_cpu",
            "default": "isolated_simulator_cpu",
            "title": "Execution",
            "type": "string"
          },
          "queued_events": {
            "maximum": 256.0,
            "minimum": 0.0,
            "title": "Queued Events",
            "type": "integer"
          },
          "recent_events": {
            "items": {
              "$ref": "#/components/schemas/EdgeIncident"
            },
            "maxItems": 128,
            "title": "Recent Events",
            "type": "array"
          }
        },
        "required": [
          "cloud",
          "queued_events",
          "dropped_events",
          "recent_events"
        ],
        "title": "EdgeStatus",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "mode": {
            "const": "local_simulation",
            "default": "local_simulation",
            "title": "Mode",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "detail"
        ],
        "title": "Health",
        "type": "object"
      },
      "MeasurementQuality": {
        "additionalProperties": false,
        "properties": {
          "age_s": {
            "maximum": 20.000001,
            "minimum": 0.0,
            "title": "Age S",
            "type": "number"
          },
          "dropped_packets": {
            "minimum": 0.0,
            "title": "Dropped Packets",
            "type": "integer"
          },
          "packet_available": {
            "title": "Packet Available",
            "type": "boolean"
          },
          "sampled_time_s": {
            "minimum": 0.0,
            "title": "Sampled Time S",
            "type": "number"
          },
          "sampled_version": {
            "minimum": 0.0,
            "title": "Sampled Version",
            "type": "integer"
          }
        },
        "required": [
          "sampled_version",
          "sampled_time_s",
          "age_s",
          "packet_available",
          "dropped_packets"
        ],
        "title": "MeasurementQuality",
        "type": "object"
      },
      "MemoryMatch": {
        "additionalProperties": false,
        "properties": {
          "distance_squared": {
            "minimum": 0.0,
            "title": "Distance Squared",
            "type": "number"
          },
          "label": {
            "enum": [
              "nominal",
              "sensor_anomaly"
            ],
            "title": "Label",
            "type": "string"
          },
          "state_version": {
            "minimum": 1.0,
            "title": "State Version",
            "type": "integer"
          }
        },
        "required": [
          "state_version",
          "distance_squared",
          "label"
        ],
        "title": "MemoryMatch",
        "type": "object"
      },
      "PhysicsState": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/TruthCell"
            },
            "maxItems": 6,
            "minItems": 6,
            "title": "Cells",
            "type": "array"
          },
          "energy_j": {
            "minimum": 0.0,
            "title": "Energy J",
            "type": "number"
          },
          "energy_residual_j": {
            "title": "Energy Residual J",
            "type": "number"
          },
          "feeder_power_w": {
            "maximum": 14500.000001,
            "minimum": 0.0,
            "title": "Feeder Power W",
            "type": "number"
          },
          "pressure_kpa": {
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Pressure Kpa",
            "type": "number"
          },
          "production_units": {
            "minimum": 0.0,
            "title": "Production Units",
            "type": "number"
          },
          "pump_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Pump Fraction",
            "type": "number"
          },
          "total_flow_kg_s": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Total Flow Kg S",
            "type": "number"
          }
        },
        "required": [
          "cells",
          "pressure_kpa",
          "total_flow_kg_s",
          "pump_fraction",
          "feeder_power_w",
          "energy_j",
          "production_units",
          "energy_residual_j"
        ],
        "title": "PhysicsState",
        "type": "object"
      },
      "PlantTelemetry": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/CellMeasurement"
            },
            "maxItems": 6,
            "minItems": 6,
            "title": "Cells",
            "type": "array"
          },
          "coolant_temperature_c": {
            "maximum": 1000.0,
            "minimum": -273.15,
            "title": "Coolant Temperature C",
            "type": "number"
          },
          "ground_truth": {
            "$ref": "#/components/schemas/PhysicsState"
          },
          "injected_fault_mask": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "Injected Fault Mask",
            "type": "integer"
          },
          "loop_pressure_kpa": {
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Loop Pressure Kpa",
            "type": "number"
          },
          "measurement": {
            "$ref": "#/components/schemas/MeasurementQuality"
          },
          "model_version": {
            "const": "coupled-factory-v3",
            "default": "coupled-factory-v3",
            "title": "Model Version",
            "type": "string"
          },
          "observed_at": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+\\+00:00$",
            "title": "Observed At",
            "type": "string"
          },
          "run_id": {
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Run Id",
            "type": "string"
          },
          "scenario_id": {
            "pattern": "^scenario-\\d{3}$",
            "title": "Scenario Id",
            "type": "string"
          },
          "scenario_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Scenario Sha256",
            "type": "string"
          },
          "schema_version": {
            "const": "3.0.0",
            "default": "3.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "seed": {
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "sentinel": {
            "$ref": "#/components/schemas/SentinelStatus"
          },
          "simulation_time_s": {
            "minimum": 0.0,
            "title": "Simulation Time S",
            "type": "number"
          },
          "simulator_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Simulator Sha256",
            "type": "string"
          },
          "source": {
            "const": "local_cpp_simulator",
            "default": "local_cpp_simulator",
            "title": "Source",
            "type": "string"
          },
          "state_version": {
            "minimum": 1.0,
            "title": "State Version",
            "type": "integer"
          }
        },
        "required": [
          "scenario_id",
          "seed",
          "state_version",
          "simulation_time_s",
          "coolant_temperature_c",
          "loop_pressure_kpa",
          "cells",
          "ground_truth",
          "measurement",
          "injected_fault_mask",
          "run_id",
          "simulator_sha256",
          "scenario_sha256",
          "observed_at",
          "sentinel"
        ],
        "title": "PlantTelemetry",
        "type": "object"
      },
      "SentinelStatus": {
        "additionalProperties": false,
        "properties": {
          "applied_policy": {
            "enum": [
              "observe_only",
              "none",
              "local_emergency_stop"
            ],
            "title": "Applied Policy",
            "type": "string"
          },
          "cpu_fallback": {
            "const": true,
            "default": true,
            "title": "Cpu Fallback",
            "type": "boolean"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/AnomalyEvidence"
            },
            "maxItems": 12,
            "title": "Evidence",
            "type": "array"
          },
          "first_detection_time_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Detection Time S"
          },
          "latched": {
            "title": "Latched",
            "type": "boolean"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "max_estimated_temperature_c": {
            "title": "Max Estimated Temperature C",
            "type": "number"
          },
          "memory_entries": {
            "maximum": 4096.0,
            "minimum": 0.0,
            "title": "Memory Entries",
            "type": "integer"
          },
          "memory_matches": {
            "items": {
              "$ref": "#/components/schemas/MemoryMatch"
            },
            "maxItems": 3,
            "title": "Memory Matches",
            "type": "array"
          },
          "npu_verified": {
            "const": false,
            "default": false,
            "title": "Npu Verified",
            "type": "boolean"
          },
          "policy_revision": {
            "const": "synthetic-shield-v1",
            "default": "synthetic-shield-v1",
            "title": "Policy Revision",
            "type": "string"
          },
          "state": {
            "enum": [
              "warming",
              "nominal",
              "anomaly",
              "latched_stop"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "evidence",
          "latched",
          "first_detection_time_s",
          "applied_policy",
          "latency_ms",
          "max_estimated_temperature_c",
          "memory_entries",
          "memory_matches"
        ],
        "title": "SentinelStatus",
        "type": "object"
      },
      "TruthCell": {
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "enum": [
              "CELL-01",
              "CELL-02",
              "CELL-03",
              "CELL-04",
              "CELL-05",
              "CELL-06"
            ],
            "title": "Cell Id",
            "type": "string"
          },
          "flow_kg_s": {
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Flow Kg S",
            "type": "number"
          },
          "temperature_c": {
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Temperature C",
            "type": "number"
          },
          "valve_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Valve Fraction",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "temperature_c",
          "flow_kg_s",
          "valve_fraction"
        ],
        "title": "TruthCell",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AEGIS GRID API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "capabilities_api_v1_capabilities_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Capabilities"
      }
    },
