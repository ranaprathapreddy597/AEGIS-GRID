{
  "components": {
    "schemas": {
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "mode": {
            "const": "local_simulation",
            "default": "local_simulation",
            "title": "Mode",
            "type": "string"
          },
          "mutations_enabled": {
            "const": false,
            "default": false,
            "title": "Mutations Enabled",
            "type": "boolean"
          },
          "phase": {
            "const": 2,
            "default": 2,
            "title": "Phase",
            "type": "integer"
          }
        },
        "required": [
          "capabilities"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "verified_local",
              "simulated",
              "blocked",
              "not_implemented"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ],
        "title": "Capability",
        "type": "object"
      },
      "CellMeasurement": {
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "enum": [
              "CELL-01",
              "CELL-02",
              "CELL-03",
              "CELL-04",
              "CELL-05",
              "CELL-06"
            ],
            "title": "Cell Id",
            "type": "string"
          },
          "heat_input_w": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Heat Input W",
            "type": "number"
          },
          "load_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Load Fraction",
            "type": "number"
          },
          "noise_bound_c": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Noise Bound C",
            "type": "number"
          },
          "temperature_c": {
            "maximum": 1000.0,
            "minimum": -273.15,
            "title": "Temperature C",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "temperature_c",
          "load_fraction",
          "heat_input_w",
          "noise_bound_c"
        ],
        "title": "CellMeasurement",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "mode": {
            "const": "local_simulation",
            "default": "local_simulation",
            "title": "Mode",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "detail"
        ],
        "title": "Health",
        "type": "object"
      },
      "MeasurementQuality": {
        "additionalProperties": false,
        "properties": {
          "age_s": {
            "maximum": 20.000001,
            "minimum": 0.0,
            "title": "Age S",
            "type": "number"
          },
          "dropped_packets": {
            "minimum": 0.0,
            "title": "Dropped Packets",
            "type": "integer"
          },
          "packet_available": {
            "title": "Packet Available",
            "type": "boolean"
          },
          "sampled_time_s": {
            "minimum": 0.0,
            "title": "Sampled Time S",
            "type": "number"
          },
          "sampled_version": {
            "minimum": 0.0,
            "title": "Sampled Version",
            "type": "integer"
          }
        },
        "required": [
          "sampled_version",
          "sampled_time_s",
          "age_s",
          "packet_available",
          "dropped_packets"
        ],
        "title": "MeasurementQuality",
        "type": "object"
      },
      "PhysicsState": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/TruthCell"
            },
            "maxItems": 6,
            "minItems": 6,
            "title": "Cells",
            "type": "array"
          },
          "energy_j": {
            "minimum": 0.0,
            "title": "Energy J",
            "type": "number"
          },
          "energy_residual_j": {
            "title": "Energy Residual J",
            "type": "number"
          },
          "feeder_power_w": {
            "maximum": 14500.000001,
            "minimum": 0.0,
            "title": "Feeder Power W",
            "type": "number"
          },
          "pressure_kpa": {
            "maximum": 180.0,
            "minimum": 0.0,
            "title": "Pressure Kpa",
            "type": "number"
          },
          "production_units": {
            "minimum": 0.0,
            "title": "Production Units",
            "type": "number"
          },
          "pump_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Pump Fraction",
            "type": "number"
          },
          "total_flow_kg_s": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Total Flow Kg S",
            "type": "number"
          }
        },
        "required": [
          "cells",
          "pressure_kpa",
          "total_flow_kg_s",
          "pump_fraction",
          "feeder_power_w",
          "energy_j",
          "production_units",
          "energy_residual_j"
        ],
        "title": "PhysicsState",
        "type": "object"
      },
      "PlantTelemetry": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/CellMeasurement"
            },
            "maxItems": 6,
            "minItems": 6,
            "title": "Cells",
            "type": "array"
          },
          "coolant_temperature_c": {
            "maximum": 1000.0,
            "minimum": -273.15,
            "title": "Coolant Temperature C",
            "type": "number"
          },
          "ground_truth": {
            "$ref": "#/components/schemas/PhysicsState"
          },
          "injected_fault_mask": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "Injected Fault Mask",
            "type": "integer"
          },
          "measurement": {
            "$ref": "#/components/schemas/MeasurementQuality"
          },
          "model_version": {
            "const": "coupled-factory-v2",
            "default": "coupled-factory-v2",
            "title": "Model Version",
            "type": "string"
          },
          "observed_at": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+\\+00:00$",
            "title": "Observed At",
            "type": "string"
          },
          "run_id": {
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Run Id",
            "type": "string"
          },
          "scenario_id": {
            "pattern": "^scenario-\\d{3}$",
            "title": "Scenario Id",
            "type": "string"
          },
          "scenario_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Scenario Sha256",
            "type": "string"
          },
          "schema_version": {
            "const": "2.0.0",
            "default": "2.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "seed": {
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "simulation_time_s": {
            "minimum": 0.0,
            "title": "Simulation Time S",
            "type": "number"
          },
          "simulator_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Simulator Sha256",
            "type": "string"
          },
          "source": {
            "const": "local_cpp_simulator",
            "default": "local_cpp_simulator",
            "title": "Source",
            "type": "string"
          },
          "state_version": {
            "minimum": 1.0,
            "title": "State Version",
            "type": "integer"
          }
        },
        "required": [
          "scenario_id",
          "seed",
          "state_version",
          "simulation_time_s",
          "coolant_temperature_c",
          "cells",
          "ground_truth",
          "measurement",
          "injected_fault_mask",
          "run_id",
          "simulator_sha256",
          "scenario_sha256",
          "observed_at"
        ],
        "title": "PlantTelemetry",
        "type": "object"
      },
      "TruthCell": {
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "enum": [
              "CELL-01",
              "CELL-02",
              "CELL-03",
              "CELL-04",
              "CELL-05",
              "CELL-06"
            ],
            "title": "Cell Id",
            "type": "string"
          },
          "flow_kg_s": {
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Flow Kg S",
            "type": "number"
          },
          "temperature_c": {
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Temperature C",
            "type": "number"
          },
          "valve_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Valve Fraction",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "temperature_c",
          "flow_kg_s",
          "valve_fraction"
        ],
        "title": "TruthCell",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AEGIS GRID API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "capabilities_api_v1_capabilities_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Capabilities"
      }
    },
    "/api/v1/telemetry/latest": {
      "get": {
        "operationId": "latest_api_v1_telemetry_latest_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantTelemetry"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Latest"
      }
    },
    "/api/v1/telemetry/stream": {
      "get": {
        "operationId": "stream_api_v1_telemetry_stream_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {}
            },
            "description": "SSE telemetry and status events"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Stream"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
