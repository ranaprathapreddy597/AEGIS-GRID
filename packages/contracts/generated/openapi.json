{
  "components": {
    "schemas": {
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "mode": {
            "const": "local_simulation",
            "default": "local_simulation",
            "title": "Mode",
            "type": "string"
          },
          "mutations_enabled": {
            "const": false,
            "default": false,
            "title": "Mutations Enabled",
            "type": "boolean"
          },
          "phase": {
            "const": 1,
            "default": 1,
            "title": "Phase",
            "type": "integer"
          }
        },
        "required": [
          "capabilities"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "verified_local",
              "simulated",
              "blocked",
              "not_implemented"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ],
        "title": "Capability",
        "type": "object"
      },
      "CellMeasurement": {
        "additionalProperties": false,
        "properties": {
          "cell_id": {
            "enum": [
              "CELL-01",
              "CELL-02",
              "CELL-03",
              "CELL-04",
              "CELL-05",
              "CELL-06"
            ],
            "title": "Cell Id",
            "type": "string"
          },
          "heat_input_w": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Heat Input W",
            "type": "number"
          },
          "load_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Load Fraction",
            "type": "number"
          },
          "temperature_c": {
            "maximum": 1000.0,
            "minimum": -273.15,
            "title": "Temperature C",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "temperature_c",
          "load_fraction",
          "heat_input_w"
        ],
        "title": "CellMeasurement",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "mode": {
            "const": "local_simulation",
            "default": "local_simulation",
            "title": "Mode",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "detail"
        ],
        "title": "Health",
        "type": "object"
      },
      "PlantTelemetry": {
        "additionalProperties": false,
        "properties": {
          "cells": {
            "items": {
              "$ref": "#/components/schemas/CellMeasurement"
            },
            "maxItems": 6,
            "minItems": 6,
            "title": "Cells",
            "type": "array"
          },
          "coolant_temperature_c": {
            "maximum": 1000.0,
            "minimum": -273.15,
            "title": "Coolant Temperature C",
            "type": "number"
          },
          "model_version": {
            "const": "thermal-bootstrap-v1",
            "default": "thermal-bootstrap-v1",
            "title": "Model Version",
            "type": "string"
          },
          "observed_at": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+\\+00:00$",
            "title": "Observed At",
            "type": "string"
          },
          "run_id": {
            "pattern": "^[0-9a-f-]{36}$",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "seed": {
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "simulation_time_s": {
            "minimum": 0.0,
            "title": "Simulation Time S",
            "type": "number"
          },
          "simulator_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Simulator Sha256",
            "type": "string"
          },
          "source": {
            "const": "local_cpp_simulator",
            "default": "local_cpp_simulator",
            "title": "Source",
            "type": "string"
          },
          "state_version": {
            "minimum": 1.0,
            "title": "State Version",
            "type": "integer"
          }
        },
        "required": [
          "seed",
          "state_version",
          "simulation_time_s",
          "coolant_temperature_c",
          "cells",
          "run_id",
          "simulator_sha256",
          "observed_at"
        ],
        "title": "PlantTelemetry",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AEGIS GRID API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "capabilities_api_v1_capabilities_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Capabilities"
      }
    },
    "/api/v1/telemetry/latest": {
      "get": {
        "operationId": "latest_api_v1_telemetry_latest_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantTelemetry"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Latest"
      }
    },
    "/api/v1/telemetry/stream": {
      "get": {
        "operationId": "stream_api_v1_telemetry_stream_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {}
            },
            "description": "SSE telemetry and status events"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Stream"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
