{
  "$defs": {
    "CandidatePlan": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "controls": {
          "$ref": "#/$defs/SimulatorControls"
        },
        "executable": {
          "const": false,
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "maximum_temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Temperature C"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "red_accepted": {
          "default": false,
          "title": "Red Accepted",
          "type": "boolean"
        },
        "simulation_checked": {
          "default": false,
          "title": "Simulation Checked",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "controls",
        "rationale"
      ],
      "title": "CandidatePlan",
      "type": "object"
    },
    "DiagnosticHypothesis": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "enum": [
            "sensor_bias",
            "true_thermal",
            "restricted_flow",
            "weak_pump",
            "overload"
          ],
          "title": "Cause",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "score_method": {
          "const": "physics_heuristic_not_probability",
          "default": "physics_heuristic_not_probability",
          "title": "Score Method",
          "type": "string"
        },
        "support_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Support Score",
          "type": "number"
        }
      },
      "required": [
        "cause",
        "support_score",
        "explanation"
      ],
      "title": "DiagnosticHypothesis",
      "type": "object"
    },
    "GraphTrace": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "iteration": {
          "title": "Iteration",
          "type": "integer"
        },
        "node": {
          "title": "Node",
          "type": "string"
        }
      },
      "required": [
        "node",
        "iteration",
        "elapsed_ms",
        "detail"
      ],
      "title": "GraphTrace",
      "type": "object"
    },
    "SimulatorControls": {
      "additionalProperties": false,
      "properties": {
        "loads": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Loads",
          "type": "array"
        },
        "pump": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pump",
          "type": "number"
        },
        "valves": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Valves",
          "type": "array"
        }
      },
      "required": [
        "pump",
        "loads",
        "valves"
      ],
      "title": "SimulatorControls",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_required": {
      "const": true,
      "default": true,
      "title": "Approval Required",
      "type": "boolean"
    },
    "backend": {
      "default": "offline_template",
      "enum": [
        "offline_template",
        "remote_vllm"
      ],
      "title": "Backend",
      "type": "string"
    },
    "baseline_maximum_temperature_c": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Maximum Temperature C"
    },
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CandidatePlan"
      },
      "maxItems": 3,
      "title": "Candidates",
      "type": "array"
    },
    "cost_usd": {
      "default": null,
      "title": "Cost Usd",
      "type": "null"
    },
    "evidence_page_hashes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Evidence Page Hashes",
      "type": "array"
    },
    "hypotheses": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DiagnosticHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "incident_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Incident Id",
      "type": "string"
    },
    "investigation_id": {
      "pattern": "^[0-9a-f-]{36}$",
      "title": "Investigation Id",
      "type": "string"
    },
    "iteration": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "title": "Iteration",
      "type": "integer"
    },
    "live_gates": {
      "const": "MI300X/Evolus/Pinecone BLOCKED",
      "default": "MI300X/Evolus/Pinecone BLOCKED",
      "title": "Live Gates",
      "type": "string"
    },
    "manual_decision": {
      "default": "no_action",
      "enum": [
        "no_action",
        "simulator_evidence_only"
      ],
      "title": "Manual Decision",
      "type": "string"
    },
    "max_iterations": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Iterations",
      "type": "integer"
    },
    "model_token_budget": {
      "default": 1024,
      "maximum": 2048,
      "minimum": 128,
      "title": "Model Token Budget",
      "type": "integer"
    },
    "model_tokens_used": {
      "default": 0,
      "maximum": 2048,
      "minimum": 0,
      "title": "Model Tokens Used",
      "type": "integer"
    },
    "native_binary_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Binary Sha256"
    },
    "observed_history_samples": {
      "default": 0,
      "maximum": 21,
      "minimum": 0,
      "title": "Observed History Samples",
      "type": "integer"
    },
    "observed_neighbor_correlations": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxItems": 6,
      "title": "Observed Neighbor Correlations",
      "type": "array"
    },
    "observed_temperature_slopes_c_s": {
      "default": [],
      "items": {
        "type": "number"
      },
      "maxItems": 6,
      "title": "Observed Temperature Slopes C S",
      "type": "array"
    },
    "operational_write_allowed": {
      "const": false,
      "default": false,
      "title": "Operational Write Allowed",
      "type": "boolean"
    },
    "phase": {
      "const": 7,
      "default": 7,
      "title": "Phase",
      "type": "integer"
    },
    "refusal": {
      "default": "",
      "title": "Refusal",
      "type": "string"
    },
    "status": {
      "default": "running",
      "enum": [
        "running",
        "paused_no_action",
        "failed_closed"
      ],
      "title": "Status",
      "type": "string"
    },
    "traces": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphTrace"
      },
      "maxItems": 80,
      "title": "Traces",
      "type": "array"
    }
  },
  "required": [
    "investigation_id",
    "incident_id"
  ],
  "title": "Investigation",
  "type": "object"
}
