{
  "additionalProperties": false,
  "properties": {
    "edge_url": {
      "default": "http://edge:8001",
      "title": "Edge Url",
      "type": "string"
    },
    "scenario_dir": {
      "default": "data\\scenarios",
      "format": "path",
      "title": "Scenario Dir",
      "type": "string"
    },
    "scenario_id": {
      "default": "scenario-000",
      "pattern": "^scenario-0\\d{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "service_token": {
      "format": "password",
      "title": "Service Token",
      "type": "string",
      "writeOnly": true
    },
    "time_scale": {
      "default": 1.0,
      "maximum": 20,
      "minimum": 0.5,
      "title": "Time Scale",
      "type": "number"
    },
    "twin_binary": {
      "default": "\\usr\\local\\bin\\aegis-twin",
      "format": "path",
      "title": "Twin Binary",
      "type": "string"
    },
    "viewer_token": {
      "format": "password",
      "title": "Viewer Token",
      "type": "string",
      "writeOnly": true
    }
  },
  "required": [
    "viewer_token",
    "service_token"
  ],
  "title": "Settings",
  "type": "object"
}
