{
  "additionalProperties": false,
  "properties": {
    "cloud_events_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cloud Events Url"
    },
    "cloud_token": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cloud Token"
    },
    "edge_url": {
      "default": "http://edge:8001",
      "title": "Edge Url",
      "type": "string"
    },
    "graph_password": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Graph Password"
    },
    "ingest_token": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingest Token"
    },
    "memory_capacity": {
      "default": 256,
      "maximum": 4096,
      "minimum": 32,
      "title": "Memory Capacity",
      "type": "integer"
    },
    "mongo_reader_password": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mongo Reader Password"
    },
    "mongo_writer_password": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mongo Writer Password"
    },
    "redis_writer_password": {
      "anyOf": [
        {
          "format": "password",
          "type": "string",
          "writeOnly": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redis Writer Password"
    },
    "safety_mode": {
      "default": "enforce",
      "enum": [
        "enforce",
        "observe_only"
      ],
      "title": "Safety Mode",
      "type": "string"
    },
    "scenario_dir": {
      "default": "data\\scenarios",
      "format": "path",
      "title": "Scenario Dir",
      "type": "string"
    },
    "scenario_id": {
      "default": "scenario-000",
      "pattern": "^scenario-0\\d{2}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "service_token": {
      "format": "password",
      "title": "Service Token",
      "type": "string",
      "writeOnly": true
    },
    "storage_enabled": {
      "default": false,
      "title": "Storage Enabled",
      "type": "boolean"
    },
    "time_scale": {
      "default": 1.0,
      "maximum": 20,
      "minimum": 0.5,
      "title": "Time Scale",
      "type": "number"
    },
    "twin_binary": {
      "default": "\\usr\\local\\bin\\aegis-twin",
      "format": "path",
      "title": "Twin Binary",
      "type": "string"
    },
    "twin_library": {
      "default": "\\usr\\local\\lib\\libaegis_twin.so",
      "format": "path",
      "title": "Twin Library",
      "type": "string"
    },
    "viewer_token": {
      "format": "password",
      "title": "Viewer Token",
      "type": "string",
      "writeOnly": true
    }
  },
  "required": [
    "viewer_token",
    "service_token"
  ],
  "title": "Settings",
  "type": "object"
}
