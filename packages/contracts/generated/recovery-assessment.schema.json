    "SimRollout": {
      "additionalProperties": false,
      "properties": {
        "actuator_travel": {
          "minimum": 0,
          "title": "Actuator Travel",
          "type": "number"
        },
        "downtime_s": {
          "minimum": 0,
          "title": "Downtime S",
          "type": "number"
        },
        "energy_kwh": {
          "minimum": 0,
          "title": "Energy Kwh",
          "type": "number"
        },
        "horizon_s": {
          "maximum": 1200,
          "minimum": 1,
          "title": "Horizon S",
          "type": "integer"
        },
        "maximum_feeder_power_w": {
          "title": "Maximum Feeder Power W",
          "type": "number"
        },
        "maximum_pressure_kpa": {
          "title": "Maximum Pressure Kpa",
          "type": "number"
        },
        "maximum_ramp_excess": {
          "minimum": 0,
          "title": "Maximum Ramp Excess",
          "type": "number"
        },
        "maximum_temperature_c": {
          "title": "Maximum Temperature C",
          "type": "number"
        },
        "minimum_flow_kg_s": {
          "title": "Minimum Flow Kg S",
          "type": "number"
        },
        "production_units": {
          "minimum": 0,
          "title": "Production Units",
          "type": "number"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/FutureSample"
          },
          "maxItems": 122,
          "title": "Samples",
          "type": "array"
        },
        "steps": {
          "maximum": 1200,
          "minimum": 1,
          "title": "Steps",
          "type": "integer"
        },
        "violation_mask": {
          "maximum": 31,
          "minimum": 0,
          "title": "Violation Mask",
          "type": "integer"
        }
