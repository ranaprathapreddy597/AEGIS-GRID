        },
        "maximum_actuator_travel": {
          "title": "Maximum Actuator Travel",
          "type": "number"
        },
        "maximum_downtime_s": {
          "title": "Maximum Downtime S",
          "type": "number"
        },
        "mean_energy_kwh": {
          "title": "Mean Energy Kwh",
          "type": "number"
        },
        "minimum_production_units": {
          "title": "Minimum Production Units",
          "type": "number"
        },
        "worst_objective": {
          "title": "Worst Objective",
          "type": "number"
        },
        "worst_temperature_c": {
          "title": "Worst Temperature C",
          "type": "number"
        }
      },
      "required": [
        "candidate_id",
        "controls",
        "feasible",
        "checked_cases",
        "failed_cases",
        "worst_temperature_c",
        "worst_objective",
        "mean_energy_kwh",
        "minimum_production_units",
        "maximum_downtime_s",
        "maximum_actuator_travel",
        "counterexamples"
