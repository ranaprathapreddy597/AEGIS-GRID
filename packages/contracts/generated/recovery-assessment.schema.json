      "required": [
        "horizon_s",
        "steps",
        "maximum_temperature_c",
        "maximum_pressure_kpa",
        "maximum_feeder_power_w",
        "minimum_flow_kg_s",
        "energy_kwh",
        "production_units",
        "downtime_s",
        "actuator_travel",
        "maximum_ramp_excess",
        "violation_mask",
        "samples"
      ],
      "title": "SimRollout",
      "type": "object"
    },
    "SimulatorControls": {
      "additionalProperties": false,
      "properties": {
        "loads": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Loads",
          "type": "array"
        },
        "pump": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pump",
          "type": "number"
        },
        "valves": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Valves",
          "type": "array"
        }
      },
      "required": [
        "pump",
        "loads",
        "valves"
      ],
      "title": "SimulatorControls",
      "type": "object"
    },
    "UncertaintyCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "fault_mask": {
          "maximum": 255,
          "minimum": 0,
          "title": "Fault Mask",
          "type": "integer"
        },
        "seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "severity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "target": {
          "maximum": 5,
          "minimum": 0,
          "title": "Target",
          "type": "integer"
        },
        "temperature_offset_c": {
          "title": "Temperature Offset C",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "seed",
        "snapshot_sha256",
        "fault_mask",
        "target",
        "severity",
        "temperature_offset_c"
      ],
      "title": "UncertaintyCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "enumerative-minimax-v1",
      "default": "enumerative-minimax-v1",
      "title": "Algorithm",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimRollout"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/PlanEvaluation"
      },
      "maxItems": 11,
      "title": "Candidates",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/UncertaintyCase"
      },
      "maxItems": 37,
      "title": "Cases",
      "type": "array"
    },
    "executable": {
      "const": false,
      "default": false,
      "title": "Executable",
      "type": "boolean"
    },
    "horizon_s": {
      "const": 600,
      "default": 600,
      "title": "Horizon S",
      "type": "integer"
    },
    "incident_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Incident Id",
      "type": "string"
    },
    "intervention": {
      "anyOf": [
        {
          "$ref": "#/$defs/SimRollout"
        },
        {
          "type": "null"
        }
      ]
    },
    "live_gates": {
      "const": "MI300X/Evolus/Pinecone BLOCKED",
      "default": "MI300X/Evolus/Pinecone BLOCKED",
      "title": "Live Gates",
      "type": "string"
    },
    "manual_action_gate": {
      "const": "BLOCKED",
      "default": "BLOCKED",
      "title": "Manual Action Gate",
      "type": "string"
    },
    "model_version": {
      "const": "coupled-factory-v3",
      "default": "coupled-factory-v3",
      "title": "Model Version",
      "type": "string"
    },
    "native_binary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Native Binary Sha256",
      "type": "string"
    },
    "native_substeps": {
      "minimum": 0,
      "title": "Native Substeps",
      "type": "integer"
    },
    "objective_weights": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Objective Weights",
      "type": "object"
    },
    "policy": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Policy",
      "type": "object"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "selected_candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Candidate Id"
    },
    "source_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Snapshot Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "checked_non_executable",
        "abstained"
      ],
      "title": "Status",
      "type": "string"
    },
    "total_rollouts": {
      "maximum": 500,
      "minimum": 0,
      "title": "Total Rollouts",
      "type": "integer"
    }
  },
  "required": [
    "artifact_sha256",
    "incident_id",
    "source_snapshot_sha256",
    "native_binary_sha256",
    "status",
    "reason",
    "policy",
    "objective_weights",
    "assumptions",
    "cases",
    "candidates",
    "selected_candidate_id",
    "total_rollouts",
    "native_substeps",
    "baseline",
    "intervention"
  ],
  "title": "RecoveryAssessment",
  "type": "object"
}
