{
  "$defs": {
    "CellMeasurement": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "enum": [
            "CELL-01",
            "CELL-02",
            "CELL-03",
            "CELL-04",
            "CELL-05",
            "CELL-06"
          ],
          "title": "Cell Id",
          "type": "string"
        },
        "flow_kg_s": {
          "maximum": 0.5,
          "minimum": 0,
          "title": "Flow Kg S",
          "type": "number"
        },
        "heat_input_w": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Heat Input W",
          "type": "number"
        },
        "load_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Load Fraction",
          "type": "number"
        },
        "noise_bound_c": {
          "maximum": 1,
          "minimum": 0,
          "title": "Noise Bound C",
          "type": "number"
        },
        "temperature_c": {
          "maximum": 1000,
          "minimum": -273.15,
          "title": "Temperature C",
          "type": "number"
        }
      },
      "required": [
        "cell_id",
        "temperature_c",
        "load_fraction",
        "heat_input_w",
        "noise_bound_c",
        "flow_kg_s"
      ],
      "title": "CellMeasurement",
      "type": "object"
    },
    "MeasurementQuality": {
      "additionalProperties": false,
      "properties": {
        "age_s": {
          "maximum": 20.000001,
          "minimum": 0,
          "title": "Age S",
          "type": "number"
        },
        "dropped_packets": {
          "minimum": 0,
          "title": "Dropped Packets",
          "type": "integer"
        },
        "packet_available": {
          "title": "Packet Available",
          "type": "boolean"
        },
        "sampled_time_s": {
          "minimum": 0,
          "title": "Sampled Time S",
          "type": "number"
        },
        "sampled_version": {
          "minimum": 0,
          "title": "Sampled Version",
          "type": "integer"
        }
      },
      "required": [
        "sampled_version",
        "sampled_time_s",
        "age_s",
        "packet_available",
        "dropped_packets"
      ],
      "title": "MeasurementQuality",
      "type": "object"
    },
    "PhysicsState": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/TruthCell"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "Cells",
          "type": "array"
        },
        "energy_j": {
          "minimum": 0,
          "title": "Energy J",
          "type": "number"
        },
        "energy_residual_j": {
          "title": "Energy Residual J",
          "type": "number"
        },
        "feeder_power_w": {
          "maximum": 14500.000001,
          "minimum": 0,
          "title": "Feeder Power W",
          "type": "number"
        },
        "pressure_kpa": {
          "maximum": 180,
          "minimum": 0,
          "title": "Pressure Kpa",
          "type": "number"
        },
        "production_units": {
          "minimum": 0,
          "title": "Production Units",
          "type": "number"
        },
        "pump_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pump Fraction",
          "type": "number"
        },
        "total_flow_kg_s": {
          "maximum": 3,
          "minimum": 0,
          "title": "Total Flow Kg S",
          "type": "number"
        }
      },
      "required": [
        "cells",
        "pressure_kpa",
        "total_flow_kg_s",
        "pump_fraction",
        "feeder_power_w",
        "energy_j",
        "production_units",
        "energy_residual_j"
      ],
      "title": "PhysicsState",
      "type": "object"
    },
    "TruthCell": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "enum": [
            "CELL-01",
            "CELL-02",
            "CELL-03",
            "CELL-04",
            "CELL-05",
            "CELL-06"
          ],
          "title": "Cell Id",
          "type": "string"
        },
        "flow_kg_s": {
          "maximum": 0.5,
          "minimum": 0,
          "title": "Flow Kg S",
          "type": "number"
        },
        "temperature_c": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Temperature C",
          "type": "number"
        },
        "valve_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Valve Fraction",
          "type": "number"
        }
      },
      "required": [
        "cell_id",
        "temperature_c",
        "flow_kg_s",
        "valve_fraction"
      ],
      "title": "TruthCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cells": {
      "items": {
        "$ref": "#/$defs/CellMeasurement"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Cells",
      "type": "array"
    },
    "coolant_temperature_c": {
      "maximum": 1000,
      "minimum": -273.15,
      "title": "Coolant Temperature C",
      "type": "number"
    },
    "ground_truth": {
      "$ref": "#/$defs/PhysicsState"
    },
    "injected_fault_mask": {
      "maximum": 255,
      "minimum": 0,
      "title": "Injected Fault Mask",
      "type": "integer"
    },
    "loop_pressure_kpa": {
      "maximum": 180,
      "minimum": 0,
      "title": "Loop Pressure Kpa",
      "type": "number"
    },
    "measurement": {
      "$ref": "#/$defs/MeasurementQuality"
    },
    "model_version": {
      "const": "coupled-factory-v3",
      "default": "coupled-factory-v3",
      "title": "Model Version",
      "type": "string"
    },
    "scenario_id": {
      "pattern": "^scenario-\\d{3}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "simulation_time_s": {
      "minimum": 0,
      "title": "Simulation Time S",
      "type": "number"
    },
    "state_version": {
      "minimum": 1,
      "title": "State Version",
      "type": "integer"
    }
  },
  "required": [
    "scenario_id",
    "seed",
    "state_version",
    "simulation_time_s",
    "coolant_temperature_c",
    "loop_pressure_kpa",
    "cells",
    "ground_truth",
    "measurement",
    "injected_fault_mask"
  ],
  "title": "TwinMeasurement",
  "type": "object"
}
